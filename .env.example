# Copy this file to `.env` and set a strong token before starting.
#
# Auth token for the web UI. REQUIRED for any real deployment — without a fixed
# token the server generates a random one on each start (printed to the logs).
# Generate a long random value, e.g.:
#   openssl rand -hex 32
CLAUDE_UI_TOKEN=change-me-to-a-long-random-string
