{
  "name": "claude-ui",
  "version": "0.1.0",
  "description": "Web GUI wrapper for the Claude Code CLI — every CLI feature, in the browser.",
  "license": "MIT",
  "author": "anitigravitylab-oss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anitigravitylab-oss/claude-ui-oss.git"
  },
  "bugs": {
    "url": "https://github.com/anitigravitylab-oss/claude-ui-oss/issues"
  },
  "homepage": "https://github.com/anitigravitylab-oss/claude-ui-oss#readme",
  "keywords": [
    "claude-code",
    "self-hosted",
    "terminal",
    "web-ui"
  ],
  "files": [
    "server/",
    "public/",
    "docs/",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "LICENSES/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "bin": {
    "claude-ui": "server/index.mjs"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs --port 7681",
    "bench": "node bench/stability.mjs",
    "test": "node --test",
    "check": "npm test && node scripts/check.mjs && node scripts/verify-vendor.mjs",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.32",
    "node-pty": "^1.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7"
  }
}
